{
    "name": "markdown-tree-view",
    "version": "1.0.0",
    "description": "Convert a Markdown document into a self-contained offline HTML tree.",
    "private": true,
    "type": "module",
    "license": "Apache-2.0",
    "engines": {
        "node": ">=24"
    },
    "bin": {
        "markdown-tree-view": "dist/markdown-tree-view/scripts/markdown-tree-view.mjs"
    },
    "scripts": {
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "lint": "eslint . --max-warnings 0",
        "type-check": "tsc -b --noEmit",
        "check": "npm run format:check && npm run lint && npm run type-check",
        "build": "node build.ts",
        "test": "node --test tests/*.test.ts",
        "verify": "npm run check && npm run build && npm run build -- --check && npm test"
    },
    "dependencies": {
        "markdown-it": "15.0.3"
    },
    "devDependencies": {
        "@allurx/js-config": "1.1.0",
        "@types/node": "24.19.2",
        "@typescript/native": "npm:typescript@7.0.2",
        "esbuild": "0.28.2",
        "eslint": "10.12.0",
        "jiti": "2.7.0",
        "prettier": "3.9.10",
        "typescript": "npm:@typescript/typescript6@6.0.2"
    },
    "prettier": "@allurx/js-config/prettier"
}
